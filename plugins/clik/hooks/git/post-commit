#!/bin/bash
# clik: refresh the code-review-graph after every commit.
#
# Catches changes Claude's PostToolUse hook can't see — edits made in your
# IDE, `git pull`/merge/rebase results, and bulk changes. Runs in the
# background so it never slows down your commit. No-ops if code-review-graph
# isn't installed or no graph exists yet.
#
# Installed by `/clik` into .git/hooks/post-commit (it chains to any existing
# hook). To install manually:
#   cp hooks/git/post-commit .git/hooks/post-commit && chmod +x .git/hooks/post-commit

command -v code-review-graph >/dev/null 2>&1 || exit 0
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -d "$REPO_ROOT/.codegraph" ] || exit 0

LOCK="$REPO_ROOT/.codegraph/.clik-update.lock"
(
  if mkdir "$LOCK" 2>/dev/null; then
    trap 'rmdir "$LOCK" 2>/dev/null' EXIT
    cd "$REPO_ROOT" && code-review-graph build >/dev/null 2>&1
  fi
) >/dev/null 2>&1 &

exit 0
